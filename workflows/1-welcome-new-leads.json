{
  "name": "Brixfit: Welcome every new lead",
  "nodes": [
    {
      "id": "note",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -60
      ],
      "parameters": {
        "content": "**Welcome every new lead**\n1. Pick your Brixfit API credential on the trigger.\n2. In \"Email the lead\", choose your email (SMTP) account and set your own From address and message.\n3. Activate the workflow.\n\nLeads without an email are skipped.",
        "width": 380,
        "height": 200
      }
    },
    {
      "id": "t",
      "name": "New lead",
      "type": "n8n-nodes-brixfit.brixfitTrigger",
      "typeVersion": 1,
      "position": [
        320,
        160
      ],
      "parameters": {
        "events": [
          "lead.created"
        ],
        "options": {}
      },
      "credentials": {
        "brixfitApi": {
          "id": "",
          "name": "Brixfit API"
        }
      },
      "webhookId": "brixfit-welcome-lead"
    },
    {
      "id": "if",
      "name": "Has an email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        560,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "Email the lead",
      "name": "Email the lead",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        800,
        140
      ],
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "you@example.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=Welcome, {{ $json.name }}!",
        "emailFormat": "text",
        "text": "=Hi {{ $json.name }},\n\nThanks for your interest. I received your details and will be in touch shortly.\n\nSpeak soon!",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "New lead": {
      "main": [
        [
          {
            "node": "Has an email?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has an email?": {
      "main": [
        [
          {
            "node": "Email the lead",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}