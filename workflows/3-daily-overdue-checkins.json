{
  "name": "Brixfit: Daily list of overdue check-ins",
  "nodes": [
    {
      "id": "note",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -60
      ],
      "parameters": {
        "content": "**Overdue check-ins**\nEvery morning at 9:00 you get one email listing clients who have not submitted their check-in. No email is sent when nobody is overdue.\n\nPick your Brixfit credential and your email (SMTP) account, then activate.",
        "width": 380,
        "height": 200
      }
    },
    {
      "id": "s",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        320,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "b",
      "name": "Get overdue check-ins",
      "type": "n8n-nodes-brixfit.brixfit",
      "typeVersion": 1,
      "position": [
        560,
        160
      ],
      "parameters": {
        "resource": "checkin",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "status": "overdue",
          "include_answers": false
        }
      },
      "credentials": {
        "brixfitApi": {
          "id": "",
          "name": "Brixfit API"
        }
      }
    },
    {
      "id": "Build the list",
      "name": "Build the list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((i) => i.json);\nif (!rows.length) return [];\nconst lines = rows.map((r) => `- ${r.client_name || 'Client'}: ${r.checkin_type} check-in, ${r.checkin_date}`);\nreturn [{ json: { count: rows.length, digest: lines.join('\\n') } }];"
      }
    },
    {
      "id": "Email me",
      "name": "Email me",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1040,
        160
      ],
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "you@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ $json.count }} overdue check-in(s)",
        "emailFormat": "text",
        "text": "=These clients have not submitted:\n\n{{ $json.digest }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Get overdue check-ins",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get overdue check-ins": {
      "main": [
        [
          {
            "node": "Build the list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build the list": {
      "main": [
        [
          {
            "node": "Email me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}